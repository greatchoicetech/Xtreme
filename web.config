<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <location path="assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="public, max-age=31536000" />
          <remove name="Expires" />
          <add name="Expires" value="Thu, 31 Dec 2030 23:59:59 GMT" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
